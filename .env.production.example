# PRODUCTION ENVIRONMENT (deployment)
# Copy to .env.production and fill in the values.
# Loaded automatically by "next build" and "next start".
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time - rebuild after changing them.
NEXT_PUBLIC_API_URL=https://YOUR_MIDDLEWARE_DOMAIN/api/v1

# Must equal the middleware's EXCHANGE_CONTRACT (EIP-712 signing domain)
NEXT_PUBLIC_EXCHANGE_CONTRACT=

# Set to true to actually POST signed orders to the middleware
NEXT_PUBLIC_TRADING_SUBMIT=true

# WalletConnect / RainbowKit project id
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_PROJECT_ID

# UMA oracle wiring - must match veritas-middleware src/infra/blockchain/addresses/contracts.ts
NEXT_PUBLIC_UMA_ORACLE=
NEXT_PUBLIC_VTK_TOKEN=

# Server-only - must equal the middleware's production ADMIN_API_KEY (openssl rand -hex 32).
# WARNING: the /api/admin proxy injects this key for ANY caller - do not deploy
# the admin area publicly until SIWE auth lands (known deployment blocker).
ADMIN_API_KEY=
